# apps/server embeds its SPA build from here; the placeholder index.html
# committed alongside internal/web/web.go is real repo content, not a build
# artifact — the blanket `dist/` rule above would otherwise swallow it.
!apps/server/internal/web/dist/
!apps/server/internal/web/dist/index.html

# Same arrangement for the landing site embedded by `pjokk landing`.
!apps/server/internal/landing/dist/
!apps/server/internal/landing/dist/index.html
!apps/server/internal/landing/dist/cta-labels.json

