{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pjokk",
  "account_id": "ec92f89b6cf6daf1d0f5c59bc2a975db", // Refsdal Holding AS
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/" is the Worker-rendered landing page; without it here the asset
    // worker would answer the root with the SPA shell and the Worker would
    // never see the request. Everything else still comes from assets.
    "run_worker_first": ["/api/*", "/"]
  },
  // Every stateful resource is pinned to the EU jurisdiction — not merely a
  // location hint, which is a preference rather than a guarantee. Jurisdiction
  // can ONLY be set when a resource is created, so a new one must be created
  // correctly from the start; see CLAUDE.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pjokk-eu",
      "database_id": "3864bfdc-bb09-41fe-b200-cde45ba81121",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pjokk-files-eu",
      "jurisdiction": "eu"
    }
  ],
  // KV has no jurisdiction option — it is globally replicated by design, so
  // recreating it would buy nothing. Keep it free of personal data: the
  // rate limiter stores a HASH of the client IP, never the address itself.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "321697d9378d4a36aa052d53d1f93f45"
    }
  ],
  "triggers": {
    // 03:15 UTC: nightly D1 → R2 backup. Every 15 min: feed reminders.
    "crons": ["15 3 * * *", "*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Overridden locally by .dev.vars; secrets (GOOGLE_CLIENT_SECRET,
    // BETTER_AUTH_SECRET) are set with `wrangler secret put`.
    "APP_URL": "https://pjokk.no",
    // Set to "1" only while creating the very first (founder) account.
    "OPEN_SIGNUP": "0",
    // Production is the ONLY indexable environment. Anything else serves the
    // landing page with noindex headers and a disallow-all robots.txt.
    "INDEXABLE": "1"
  },
  // The app lives on the apex: pjokk.no/ is the public landing page and
  // pjokk.no/home is the signed-in app. workers.dev is off — with a canonical
  // apex, a second origin serving auth is a liability, not a fallback.
  //
  // app.pjokk.no is RETIRED. Deleting the route here is not enough: the
  // custom domain must also be removed in the Cloudflare dashboard, or its
  // DNS record and certificate stay attached to this Worker.
  "workers_dev": false,
  "routes": [{ "pattern": "pjokk.no", "custom_domain": true }],
  "env": {
    // Test environment: deploys as the `pjokk-test` worker with fully
    // isolated data (own D1/KV/R2) at app-test.pjokk.no. CI deploys it on
    // every push to main; production stays a manual `pnpm deploy`.
    // Stripe TEST-MODE keys live here — the billing smoke pass runs against
    // this env, never against production with test keys.
    // Bindings are NOT inherited by environments, hence the repetition.
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pjokk-test-eu",
          "database_id": "2c07adf8-ff38-4650-9397-a36958faf0fe",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "pjokk-test-files-eu",
          "jurisdiction": "eu"
        }
      ],
      "kv_namespaces": [
        { "binding": "KV", "id": "8f32ad05796a4c7f86ab9e1f81f1640c" }
      ],
      "triggers": { "crons": ["15 3 * * *", "*/15 * * * *"] },
      "vars": {
        "APP_URL": "https://test.pjokk.no",
        "OPEN_SIGNUP": "0",
        // Never "1": the test environment must stay out of search results.
        "INDEXABLE": "0"
      },
      // No workers.dev fallback here: that origin isn't in better-auth's
      // trusted origins, so exposing it would only serve a broken login.
      "workers_dev": false,
      // app-test.pjokk.no is RETIRED — delete that custom domain in the
      // Cloudflare dashboard too, not just this line.
      "routes": [{ "pattern": "test.pjokk.no", "custom_domain": true }]
    }
  }
}
