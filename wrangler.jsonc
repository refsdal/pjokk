{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pjokk",
  "account_id": "ec92f89b6cf6daf1d0f5c59bc2a975db", // Refsdal Holding AS
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pjokk",
      "database_id": "e9d50b4e-2680-4819-ad7e-ef8a20553568",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pjokk-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "321697d9378d4a36aa052d53d1f93f45"
    }
  ],
  "triggers": {
    // 03:15 UTC: nightly D1 → R2 backup. Every 15 min: feed reminders.
    "crons": ["15 3 * * *", "*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Overridden locally by .dev.vars; secrets (GOOGLE_CLIENT_SECRET,
    // BETTER_AUTH_SECRET) are set with `wrangler secret put`.
    "APP_URL": "https://app.pjokk.no",
    // Set to "1" only while creating the very first (founder) account.
    "OPEN_SIGNUP": "0"
  },
  // The app lives on app.pjokk.no; the apex is a separate landing page that
  // merely links here. workers.dev stays on as a fallback origin.
  "workers_dev": true,
  "routes": [{ "pattern": "app.pjokk.no", "custom_domain": true }]
}
