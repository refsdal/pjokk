# Copy to .env for docker compose, or export these for a bare `bun run start`.
# Only the first block is required; everything else has a working default or
# simply switches a feature off.
#
# Configuration is validated at startup (apps/server/src/env.ts): a bad value
# stops the process with a message naming every problem, rather than
# surfacing later as a puzzling 500.

# --- Required ---

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own origin (app.pjokk.no in production). better-auth signs
# cookies and builds OAuth callbacks from this, so a wrong value breaks
# sign-in in ways that look like anything but a configuration error.
APP_URL=http://localhost:3000

# The public marketing/legal site on the apex (pjokk.no). The SPA links out
# to its legal pages there (Settings, Login, Join) — see apps/frontend/src/
# lib/site.ts — so a self-hoster who runs their own apex should set this to
# their own origin instead of inheriting Refsdal Holding AS's. Not read by
# the container at runtime beyond that link-building; it is also read at
# BUILD time by apps/landing (see the landing-build section below).
SITE_URL=https://pjokk.no

# --- Provided by docker compose; set these only for a bare run ---

# DATABASE_URL=postgres://pjokk:pjokk@localhost:5432/pjokk
# S3_BUCKET=pjokk-files
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=pjokkdev
# S3_SECRET_ACCESS_KEY=pjokkdevsecret
# S3_REGION=auto

# Used by docker compose for the database and MinIO containers.
POSTGRES_PASSWORD=pjokk
S3_ACCESS_KEY_ID=pjokkdev
S3_SECRET_ACCESS_KEY=pjokkdevsecret

# --- Behaviour ---

# Open signup is DISABLED: accounts are created through the invite flow.
# Set to 1 only to create the very first (founder) account, then back to 0.
OPEN_SIGNUP=0

# Number of reverse proxies in front of the app. The rate limiter reads
# X-Forwarded-For ONLY when this is set, and counts from the right — leaving
# it at 0 while running behind a proxy means every caller shares one bucket;
# setting it higher than the real number lets callers forge their address.
TRUSTED_PROXY_HOPS=0

# Scheduled work (reminders, nightly backup) is no longer an env flag — it is
# driven by which dispatch mode you run. No argument (the default) and
# `worker` both run the in-process scheduler; `server` never does. See the
# README's "Scheduled work" section.

PORT=3000

# Migrator-only: where apps/server/src/migrate.ts looks for SQL migration
# files. Leave unset in the image — WORKDIR /app makes the default
# (./migrations) correct there; only needed for a migrate run from an
# unusual working directory.
# MIGRATIONS_DIR=./migrations

# --- Optional subsystems: absent means off ---

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push. Generate a pair with: node scripts/gen-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Billing. Without these the premium gates simply never open.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_LIFETIME=

# --- apps/landing build only (the static marketing/legal site; NOT read by
# the container at runtime) ---
#
# Run with: bun run --filter @pjokk/landing build
# (or `bun run build:landing` from the repo root). Output lands in
# apps/landing/dist/ and is not published anywhere automatically — see
# README.md for how it reaches the apex.

# Same meaning as SITE_URL/APP_URL above, but read directly from
# process.env at BUILD time (apps/landing/build.ts), since the landing site
# is static output with no server of its own to validate them at startup.
# SITE_URL=https://pjokk.no
# APP_URL=https://app.pjokk.no

# Same flag as OPEN_SIGNUP above: decides the landing page's call-to-action
# copy ("Get started" vs "Sign in") at build time.
# OPEN_SIGNUP=0

# Fail-safe default is noindex: an unset or non-"1" value means the build
# emits <meta name="robots" content="noindex, nofollow">, robots.txt
# disallows everything, and no sitemap.xml is written. Set to 1 only for the
# production build of the apex.
# INDEXABLE=0
