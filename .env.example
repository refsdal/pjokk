# Copy to .env for docker compose, or export these for a bare `bun run start`.
# Only the first block is required; everything else has a working default or
# simply switches a feature off.
#
# Configuration is validated at startup (apps/api/src/config.ts): a bad value
# stops the process with a message naming every problem, rather than
# surfacing later as a puzzling 500.

# --- Required ---

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public origin. better-auth signs cookies and builds OAuth callbacks
# from this, so a wrong value breaks sign-in in ways that look like anything
# but a configuration error.
APP_URL=http://localhost:3000

# --- Provided by docker compose; set these only for a bare run ---

# DATABASE_URL=postgres://pjokk:pjokk@localhost:5432/pjokk
# S3_BUCKET=pjokk-files
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=pjokkdev
# S3_SECRET_ACCESS_KEY=pjokkdevsecret
# S3_REGION=auto

# Used by docker compose for the database and MinIO containers.
POSTGRES_PASSWORD=pjokk
S3_ACCESS_KEY_ID=pjokkdev
S3_SECRET_ACCESS_KEY=pjokkdevsecret

# --- Behaviour ---

# Production is the only environment that should be crawlable. Gates
# robots.txt, sitemap.xml and the noindex headers.
INDEXABLE=0

# Open signup is DISABLED: accounts are created through the invite flow.
# Set to 1 only to create the very first (founder) account, then back to 0.
OPEN_SIGNUP=0

# Number of reverse proxies in front of the app. The rate limiter reads
# X-Forwarded-For ONLY when this is set, and counts from the right — leaving
# it at 0 while running behind a proxy means every caller shares one bucket;
# setting it higher than the real number lets callers forge their address.
TRUSTED_PROXY_HOPS=0

# Run the scheduled jobs in-process. Correct for a single container; leave at
# 0 under Kubernetes and drive `bun run cron nightly|frequent` from a CronJob,
# or every replica will fire every reminder.
SCHEDULER=0

PORT=3000

# Migrator-only: where apps/server/src/migrate.ts looks for SQL migration
# files. Leave unset in the image — WORKDIR /app makes the default
# (./migrations) correct there; only needed for a migrate run from an
# unusual working directory.
# MIGRATIONS_DIR=./migrations

# --- Optional subsystems: absent means off ---

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push. Generate a pair with: node scripts/gen-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Billing. Without these the premium gates simply never open.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_LIFETIME=
