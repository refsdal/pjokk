# Pjokk configuration. Copy to .env and edit:
#
#   cp .env.example .env
#
# Every variable below is read by apps/server/internal/config, which
# validates the whole set at startup and reports EVERY problem at once — so a
# misconfigured container crash-loops loudly on boot rather than surfacing as
# a 500 on the first request that happens to need the missing setting.
#
# This file is the complete contract. If a variable is not listed here, the
# app does not read it.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs sessions and derives the key used to digest client IPs. At least 32
# bytes. Generate one and keep it: changing it signs everybody out.
#
#   openssl rand -base64 32
AUTH_SECRET=

# Where the app is reached from a browser. Absolute URL, no trailing slash.
# OAuth redirects and cookie Secure-ness are derived from it — an https:// URL
# gets Secure cookies, a plain http:// one does not (so a LAN deployment
# works at all).
APP_URL=http://localhost:3000

# Postgres connection string. docker-compose.yml sets this to its own `db`
# service; override only when pointing at a database you already run.
#
# EU data residency: this database holds GDPR Article 9 health data about
# children. It must live in the EU. Nothing enforces that for you.
# DATABASE_URL=postgres://pjokk:pjokk@db:5432/pjokk


# ---------------------------------------------------------------------------
# Object storage — vaccine documents and the nightly backup
# ---------------------------------------------------------------------------

# "fs" or "s3". fs is the default in docker-compose.yml: files go to a local
# volume and the stack is two containers instead of four. Choose s3 when you
# already have a bucket, or want backups somewhere the container is not.
STORAGE_DRIVER=fs

# STORAGE_DRIVER=fs only. The directory files are written to; must exist and
# be writable by uid 65532 (the container's unprivileged user). The image
# creates /data with that ownership so a fresh named volume inherits it.
STORAGE_FS_PATH=/data

# STORAGE_DRIVER=s3 only — all four required, and used by
# docker-compose.s3.yml's MinIO as well.
#
# EU data residency again, and this one is the easy mistake: the nightly
# backup written to this bucket contains EVERY table, health data included.
# A bucket in the wrong region undoes the whole arrangement, and no error
# will tell you.
# S3_BUCKET=pjokk-files
# S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional; defaults to "auto" (right for R2 and MinIO, wrong for most
# managed buckets — set the real EU region).
# S3_REGION=auto


# ---------------------------------------------------------------------------
# Optional subsystems — absent means the feature is simply off, and the app
# names the disabled ones in its boot log.
# ---------------------------------------------------------------------------

# Google sign-in. Both or neither; one alone counts as unconfigured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Web push (feed reminders, calendar reminders). Both or neither.
#
#   bun scripts/gen-vapid.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# "0" or "1". 0 (the default) closes signup: accounts can only be created
# through the invite-code redeem flow. Set 1 for the very first account on a
# fresh self-hosted instance, then set it back to 0.
OPEN_SIGNUP=0

# Number of reverse proxies in front of the app. 0 (the default) means
# X-Forwarded-For is ignored entirely — which is correct when nothing is in
# front, and wrong behind an ingress, where it silently buckets every caller
# into one shared rate limit.
TRUSTED_PROXY_HOPS=0

# Port the app listens on inside the container. Compose publishes it on the
# host under the same name.
PORT=3000

# The public apex the SPA links its legal pages to. Baked into the client
# bundle at BUILD time (Dockerfile's SITE_URL build arg), not read at runtime
# by the browser — setting it here only affects the server's own view.
# Defaults to https://pjokk.no.
# SITE_URL=https://pjokk.no


# ---------------------------------------------------------------------------
# docker-compose.yml only — not read by the app
# ---------------------------------------------------------------------------

# Password for the bundled Postgres. Change it for anything but a laptop.
POSTGRES_PASSWORD=pjokk

# docker-compose.s3.yml only: the credentials its MinIO is created with, so
# they must match the S3_* pair above. Left at dev defaults if unset.
# S3_ACCESS_KEY_ID=pjokkdev
# S3_SECRET_ACCESS_KEY=pjokkdevsecret


# ---------------------------------------------------------------------------
# apps/landing build only — the static marketing/legal site on the apex. NOT
# read by the container at runtime; the landing site has no server.
# ---------------------------------------------------------------------------
#
# Run with `bun run build:landing`. Output lands in apps/landing/dist/ and is
# not published anywhere automatically — see README.md.
#
# SITE_URL and APP_URL mean the same as above but are read straight from
# process.env at build time (apps/landing/build.ts), since static output has
# no startup to validate them at.
# SITE_URL=https://pjokk.no
# APP_URL=https://pjokk.no

# Same flag as OPEN_SIGNUP above; decides the landing page's call-to-action
# copy ("Get started" vs "Sign in") at build time.
# OPEN_SIGNUP=0

# Fail-safe default is noindex: unset or not "1" means the build emits
# <meta name="robots" content="noindex, nofollow">, robots.txt disallows
# everything, and no sitemap.xml is written. Set to 1 only for the production
# build of the apex.
# INDEXABLE=0


# ---------------------------------------------------------------------------
# Gone, deliberately
# ---------------------------------------------------------------------------
#
# BETTER_AUTH_SECRET is now AUTH_SECRET (the auth library changed; the
# variable name followed). The STRIPE_* group is absent because the Go server
# has no billing — a self-hosted tracker has nobody to bill, so setting them
# does nothing.
