{
  "name": "pjokk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:server": "bun --watch apps/server/src/main.ts",
    "build": "bun run build:client && bun run build:server",
    "start": "bun apps/server/src/main.ts",
    "cron": "bun apps/server/src/cron-cli.ts",
    "check": "biome check . && node scripts/check-i18n.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "MIGRATIONS_DIR=apps/api/migrations bun apps/server/src/migrate.ts",
    "seed": "bun scripts/seed.mjs",
    "build:client": "vite build",
    "build:server": "bun build apps/server/src/main.ts apps/server/src/cron-cli.ts apps/server/src/migrate.ts --target=bun --outdir=dist/server --sourcemap=linked"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "@better-auth/stripe": "^1.7.2",
    "@hono/zod-openapi": "^1.6.1",
    "@hookform/resolvers": "^5.9.1",
    "@scalar/hono-api-reference": "^0.11.16",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/query-async-storage-persister": "^5.102.1",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-query-persist-client": "^5.102.1",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "idb-keyval": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "stripe": "22.5.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ]
}
